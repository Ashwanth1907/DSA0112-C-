#include <iostream>
using namespace std;

class Student {
    public:
    string name;
    int age;

    Student(string n, int a) {
        name = n;
        age = a;
        cout << "Constructor called: Student object created." << endl;
    }

    void display() {
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
    }

    ~Student() {
        cout << "Destructor called: Student object destroyed." << endl;
    }
};

int main() {
    Student s1("John", 20);
    s1.display();

    return 0;
}
